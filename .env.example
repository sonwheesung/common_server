# 공통 서버 환경변수 (실제 값은 .env.local 에 — 절대 커밋 금지)
# 스캐폴드는 이 값들 없이도 부팅된다. DB만 없으면 /api/health 가 db:"down" 으로 응답.

# ── DB (Supabase Postgres) ──
# 런타임(서버리스)은 Transaction 풀러(:6543) 문자열. db/index.ts 가 prepare:false 로 붙는다.
#   Supabase 대시보드 → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
# 마이그레이션(npm run db:push)만은 Session/Direct(:5432) 문자열로 실행:
#   DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres" npm run db:push

# ── 관리자 콘솔 (fail-closed — 16자 미만이면 관리자 기능 전면 차단) ──
ADMIN_TOKEN=change-me-min-16-chars-random

# ── 레이트리밋 (미설정이면 fail-open no-op → DB 일일 캡이 실질 방어선) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 디스코드 문의 알림 (비우면 완전 no-op) ──
#   앱별 채널: DISCORD_TICKET_WEBHOOK_URL_<APP_CODE 대문자>. 없으면 아래 기본으로 폴백.
DISCORD_TICKET_WEBHOOK_URL=
DISCORD_TICKET_WEBHOOK_URL_MYWORD=

# ── 크론(보관기간 파기) — Vercel이 크론콜에 Bearer로 자동 첨부 ──
CRON_SECRET=dev-cron-secret

# ── Sentry (배포 환경에서만 전송 — 로컬 dev 500이 운영 알림을 폭주시키지 않게) ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_FORCE_LOCAL=1   # 탈출구: 로컬에서도 전송(연동 검증 전용)
